# syntax=docker/dockerfile:1
#
# Customer PWA (spec §4.2), deployed to Cloud Run under standing rule R8.

# ---------------------------------------------------------------------------
# Builder
# ---------------------------------------------------------------------------
FROM node:24-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/contracts/package.json packages/contracts/
COPY packages/web-customer/package.json packages/web-customer/

RUN npm ci --no-audit --no-fund

COPY tsconfig.base.json ./
COPY packages/contracts packages/contracts
COPY packages/web-customer packages/web-customer

# Contracts first: the web app resolves it through its dist output. Getting
# this order wrong is what broke the first CI run of P1.5.
RUN npm run build -w @freshkirana/contracts
RUN npm run build -w @freshkirana/web-customer

# ---------------------------------------------------------------------------
# Runtime — Next.js standalone output only
# ---------------------------------------------------------------------------
FROM node:24-alpine AS runtime

# Signals, not a shell, as PID 1: without this the container ignores SIGTERM
# and every deploy waits out the platform's kill timeout instead of draining.
RUN apk add --no-cache tini

WORKDIR /app

ENV NODE_ENV=production
# Next reads PORT; Cloud Run injects it. Declared for local runs only.
ENV PORT=3000

# `standalone` carries a traced, minimal node_modules — an order of magnitude
# smaller than copying the workspace.
COPY --from=builder /app/packages/web-customer/.next/standalone ./
COPY --from=builder /app/packages/web-customer/.next/static ./packages/web-customer/.next/static
COPY --from=builder /app/packages/web-customer/public ./packages/web-customer/public

USER node
EXPOSE 3000

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "packages/web-customer/server.js"]
