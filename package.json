{
  "name": "freshkirana",
  "version": "0.0.0",
  "private": true,
  "description": "FreshKirana - multi-vendor grocery marketplace",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w @freshkirana/contracts && npm run build -w @freshkirana/api",
    "build:web": "npm run build -w @freshkirana/contracts && npm run build -w @freshkirana/web-customer",
    "check:budget": "npm run check:budget -w @freshkirana/web-customer",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:generate": "npm run db:generate -w @freshkirana/api",
    "db:migrate": "npm run db:migrate -w @freshkirana/api",
    "check:boundaries": "npm run check:boundaries -w @freshkirana/api",
    "check:schemas": "node scripts/check-schema-ownership.mjs",
    "verify": "npm run format:check && npm run lint && npm run check:schemas && npm run build && npm run check:boundaries && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
