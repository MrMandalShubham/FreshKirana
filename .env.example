# Copy to .env for local development. Never commit .env (rule R7).

NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Default: Cloud SQL staging, via the Cloud SQL Auth Proxy.
#
#   gcloud components install cloud-sql-proxy
#   cloud-sql-proxy --port 5432 $(terraform -chdir=infra/terraform output -raw sql_connection_name)
#
# Get the real value with:
#   terraform -chdir=infra/terraform output -raw local_database_url
#
# See infra/README.md.
DATABASE_URL=postgresql://freshkirana:REPLACE_ME@127.0.0.1:5432/freshkirana

# Fallback: local containers (npm run db:up). Uncomment to use instead.
# DATABASE_URL=postgresql://freshkirana:freshkirana_local@localhost:5432/freshkirana

REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Razorpay (decision B3)
# ---------------------------------------------------------------------------
# KEY_ID is public — it goes into the checkout SDK in the browser.
# KEY_SECRET and WEBHOOK_SECRET are secrets: on GCP they come from Secret
# Manager, never from this file (rule R7).
#
# WEBHOOK_SECRET is not issued by Razorpay — you choose it when adding the
# webhook in their dashboard, and the same string goes here. Make it long and
# random; it is the only thing standing between the webhook and anyone who
# knows the URL.
#
# Leave these empty to use the mock provider, which is what the tests exercise.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ACCOUNT_NUMBER belongs to RazorpayX (payouts), not to accepting payments.
# Only needed if settlement goes through RazorpayX rather than Route (P5.3).
# RAZORPAY_ACCOUNT_NUMBER=
