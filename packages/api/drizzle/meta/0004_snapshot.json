          "value": "\"catalog\".\"master_product\".\"net_quantity\" > 0"
        },
        "master_product_gst_rate_sane": {
          "name": "master_product_gst_rate_sane",
          "value": "\"catalog\".\"master_product\".\"gst_rate_bp\" >= 0 and \"catalog\".\"master_product\".\"gst_rate_bp\" <= 5000"
        },
        "master_product_hsn_shape": {
          "name": "master_product_hsn_shape",
          "value": "\"catalog\".\"master_product\".\"hsn_code\" ~ '^[0-9]{4}([0-9]{2}([0-9]{2})?)?$'"
