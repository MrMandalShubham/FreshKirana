{
  "name": "@freshkirana/api",
  "version": "0.0.0",
  "private": true,
  "description": "FreshKirana API - modular monolith (spec §2.1)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/db/migrate.js",
    "db:studio": "drizzle-kit studio",
    "check:boundaries": "depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@freshkirana/contracts": "*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.2",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.10.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "dependency-cruiser": "^16.7.0",
    "drizzle-kit": "^0.30.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "unplugin-swc": "^1.5.1"
  }
}
